generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id                String         @id @default(uuid())
  barcode           String?        @unique
  name              String
  category          String
  price             Float
  stock             Int            @default(0)
  lowStockThreshold Int            @default(10)
  bindingVariant    String?
  hsn               String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  billLineItems     BillLineItem[]
}

model Party {
  id                 String   @id @default(uuid())
  name               String
  proprietorName     String   @default("")
  address            String
  phone              String
  email              String?
  aadharNumber       String?
  discountPercentage Float    @default(0)
  outstandingBalance Float    @default(0)
  bankName           String   @default("")
  bankAccountNo      String   @default("")
  bankIfsc           String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  bills              Bill[]
}

model Transporter {
  id        String   @id @default(uuid())
  name      String
  phone     String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bills     Bill[]
}

model Bill {
  id            String         @id @default(uuid())
  type          String
  billNumber    String         @unique
  date          DateTime       @default(now())
  partyId       String?
  party         Party?         @relation(fields: [partyId], references: [id])
  transporterId String?
  transporter   Transporter?   @relation(fields: [transporterId], references: [id])
  subtotal      Float
  discount      Float          @default(0)
  cgst          Float          @default(0)
  sgst          Float          @default(0)
  total         Float
  paymentAmount Float          @default(0)
  status        String         @default("completed")
  vehicleNo     String?
  destination   String?
  driverName    String?
  lrNo          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lineItems     BillLineItem[]
}

model BillLineItem {
  id              String   @id @default(uuid())
  billId          String
  bill            Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int
  mrp             Float
  discountPercent Float    @default(0)
  amount          Float
  rate            Float?
  hsn             String?
}

model Settings {
  id              Int      @id @default(1)
  companyName     String   @default("")
  companyAddress  String   @default("")
  companyCity     String   @default("")
  companyGstin    String   @default("")
  companyState    String   @default("")
  companyContact  String   @default("")
  companyEmail    String   @default("")
  companyPan      String   @default("")
  bankAccountName String   @default("")
  bankName        String   @default("")
  bankAccountNo   String   @default("")
  bankIfsc        String   @default("")
}
